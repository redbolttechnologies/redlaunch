# Copy this file to .env and fill in the Google OAuth values before starting
# Redlaunch. The real .env file is ignored by Git.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local fallback callback; the configured public hostname uses its HTTPS host.
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=false

# Keep the management listener on loopback for SSH-only access. For the
# managed HTTPS mode, set both values before restarting Compose:
# MANAGEMENT_ACCESS_MODE=managed-https
# APP_BIND_ADDRESS=0.0.0.0
MANAGEMENT_ACCESS_MODE=ssh-only
APP_BIND_ADDRESS=127.0.0.1
